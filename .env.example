# dirtbike-tracker environment. Not auto-loaded: export these in your shell
# or set them inline on the cron line (see scripts/install_cron.sh).

# ntfy.sh topic for push alerts. Required unless `dirtbike watch --no-notify`.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Optional: healthchecks.io ping URL, hit after every completed `watch`.
# Alerts when pings stop (cron dead). Treat as a secret: anyone with it can ping.
HEALTHCHECK_URL=
