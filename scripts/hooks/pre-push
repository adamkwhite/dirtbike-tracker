#!/bin/bash
# Pre-push hook: block direct pushes to main, enforcing the PR-only workflow
# documented in CLAUDE.md.
#
# Reads the refs being pushed from STDIN, which is what git actually hands a
# pre-push hook, one line per ref:
#
#     <local_ref> <local_sha> <remote_ref> <remote_sha>
#
# The previous version inspected `git branch --show-current` instead. That is
# the wrong question -- it describes where you are standing, not what you are
# pushing -- and it got the answer wrong in both directions:
#
#   FALSE POSITIVE: `git push origin --delete some-merged-branch` while on main
#     was blocked, though nothing about main was touched.
#
#   FALSE NEGATIVE: `git push origin HEAD:main` from a feature branch was
#     ALLOWED, because the local branch was not "main". That is precisely the
#     thing this hook exists to prevent, so the old version failed open on its
#     own stated purpose.
#
# Deleting a protected branch is still a push to it, so that stays blocked.

set -u

blocked=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    # Defensive: git sends no trailing blank line, but a stray one is harmless.
    [ -z "${remote_ref:-}" ] && continue

    case "$remote_ref" in
        refs/heads/main | refs/heads/master) ;;
        *) continue ;;
    esac

    branch="${remote_ref#refs/heads/}"
    echo ""
    echo "❌ ERROR: Direct pushes to '$branch' are blocked!"
    echo ""
    echo "This repository requires all changes to go through pull requests."
    echo ""
    echo "To fix this:"
    echo "  1. Create a feature branch: git checkout -b feature/your-description"
    echo "  2. Cherry-pick your commits: git cherry-pick <commit-hash>"
    echo "  3. Push the feature branch: git push -u origin feature/your-description"
    echo "  4. Create a PR: gh pr create"
    echo ""
    echo "See CLAUDE.md for the complete workflow."
    echo ""
    blocked=1
done

exit "$blocked"
